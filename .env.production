# Azure Storage Configuration for Cloud Backup
# Uses Entra ID (Azure AD) authentication with RBAC for secure access

# Storage Account Name
REACT_APP_AZURE_STORAGE_ACCOUNT=cricktime

# Container Name (will be created if it doesn't exist)
REACT_APP_AZURE_CONTAINER=backups

# Azure AD / Entra Configuration
# Tenant ID - IMPORTANT: Set based on your app registration configuration
# - Use your specific tenant ID (Azure Portal -> App Registration -> Directory (tenant) ID) if app is single-tenant
# - Use 'common' for multi-tenant (any organizational account + personal Microsoft accounts)
# - Use 'organizations' for any organizational account (no personal accounts)
# - Use 'consumers' for personal Microsoft accounts only
REACT_APP_AZURE_TENANT_ID=consumers

# Application (Client) ID from your App Registration
REACT_APP_AZURE_CLIENT_ID=d64bd21a-1627-4ff5-96b7-c1cef325cf5a

# Setup Instructions:
# 1. The app registration (4cb6959c-34a4-4715-9b75-6f39042c0b44) MUST be configured with:
#    - Supported account types: Match your REACT_APP_AZURE_TENANT_ID setting above
#    - Platform: Single Page Application (SPA)
#    - Redirect URIs: 
#      * http://localhost:3000 (development)
#      * http://localhost:3000/ (development with trailing slash)
#      * https://jurglefoogle.github.io/CrickTime/ (production)
#      * https://jurglefoogle.github.io/CrickTime (production without trailing slash)
#    - Implicit grant: Enable BOTH "Access tokens" and "ID tokens"
#    - API Permissions: 
#      * Azure Storage -> user_impersonation (delegated) - MUST be granted
#      * Microsoft Graph -> User.Read (optional, for user info)
#
# 2. Each user must have "Storage Blob Data Contributor" role on the storage account
#    This is required for RBAC-based access to Azure Blob Storage
#    To assign the role:
#    Azure Portal -> Storage Account (cricktime) -> Access Control (IAM) 
#    -> Add role assignment -> Storage Blob Data Contributor -> Select user
#
# 3. Backups are automatically separated by user:
#    - Structure: backups/user@email.com/backup-2025-11-23.json
#    - Each user only sees their own backups
#    - No risk of users overwriting each other's data
#
# 4. Authentication flow:
#    - User signs in with their Microsoft account (Entra ID)
#    - App uses user's credentials to access Azure Storage via RBAC
#    - No secrets are stored in the client-side code
#
# Reference Info:
# Storage Account: cricktime
# Resource ID: 748922a0-28e1-48db-9162-0e9094f6e793
# App Object ID: 27ca3635-7c8c-4a0f-b803-53fb8a7c6dae
